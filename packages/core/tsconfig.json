{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "lib": ["ES2022"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@nanoforge/protocol": ["../protocol/src/index.ts"],
      "@nanoforge/protocol/*": ["../protocol/src/*"],
      "@protocol": ["../protocol/src/index.ts"],
      "@protocol/*": ["../protocol/src/*"]
    }
  },
  "references": [
    { "path": "../protocol" }
  ],
  "include": ["src/**/*"]
}
