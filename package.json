{
  "name": "nanoforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:all": "turbo run build",
    "lint": "eslint .",
    "lint:all": "turbo run lint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:all": "turbo run test",
    "test:protocol": "vitest run --config packages/protocol/vitest.config.ts",
    "test:host": "vitest run --config apps/agent-host/vitest.config.ts",
    "test:core": "vitest run --config packages/core/vitest.config.ts",
    "test:sdk": "vitest run --config packages/sdk/vitest.config.ts",
    "test:e2e": "vitest run tests/e2e",
    "typecheck": "turbo run typecheck",
    "typecheck:all": "turbo run typecheck",
    "typecheck:protocol": "tsc -p packages/protocol/tsconfig.json",
    "typecheck:host": "tsc -p apps/agent-host/tsconfig.json",
    "typecheck:core": "tsc -p packages/core/tsconfig.json",
    "typecheck:sdk": "tsc -p packages/sdk/tsconfig.json",
    "turbo:build": "turbo run build",
    "turbo:typecheck": "turbo run typecheck",
    "turbo:test": "turbo run test",
    "turbo:lint": "turbo run lint",
    "start:host": "tsx apps/agent-host/src/server.ts",
    "start:launcher": "node scripts/nanoforge-launcher.cjs",
    "desktop:dev": "pnpm package && electron desktop/main.cjs",
    "desktop:build": "pnpm build && pnpm package && electron-builder --win nsis --x64",
    "package": "node scripts/package-release.js",
    "build:exe": "node scripts/build-exe.js"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.nanoforge.desktop",
    "productName": "NanoForge",
    "directories": {
      "output": "release/desktop-app"
    },
    "asar": false,
    "files": [
      "desktop/**",
      "dist/**",
      "scripts/**",
      "apps/agent-host/dist/**",
      "apps/agent-host/src/policy/default-policy.json",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "NanoForge-Desktop-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@nanoforge/protocol": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.14",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.70.0",
    "react-resizable-panels": "^4.2.2",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.23",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "kimi-plugin-inspect-react": "^1.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.12",
    "turbo": "^2.4.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.10",
    "ws": "^8.18.0"
  }
}
