{
  "version": 1,
  "workspaceRoot": ".",
  "comment": "Locked-down defaults per docs/plans/2026-08-11-agent-platform-modules.md security contracts: read-only inside the workspace auto-allows; writes/network/install/termination/redirection ask; free-form shells and shell composition deny.",
  "shells": [
    "cmd",
    "powershell",
    "pwsh",
    "bash",
    "sh",
    "zsh",
    "fish",
    "ash",
    "dash",
    "ksh",
    "cscript",
    "wscript",
    "mshta",
    "wsl"
  ],
  "deniedExecutables": [
    "sudo",
    "doas",
    "runas",
    "psexec"
  ],
  "askExecutables": [
    "npm",
    "npx",
    "pnpm",
    "yarn",
    "bun",
    "deno",
    "corepack",
    "pip",
    "pip3",
    "pipx",
    "python",
    "python3",
    "rm",
    "del",
    "erase",
    "rmdir",
    "rd",
    "mv",
    "move",
    "ren",
    "rename",
    "cp",
    "copy",
    "xcopy",
    "robocopy",
    "curl",
    "wget",
    "ssh",
    "scp",
    "sftp",
    "ftp",
    "telnet",
    "nc",
    "ncat",
    "kill",
    "taskkill",
    "pkill",
    "tskill",
    "chmod",
    "chown",
    "icacls",
    "attrib",
    "takeown",
    "msiexec",
    "apt",
    "apt-get",
    "brew"
  ],
  "readOnly": [
    {
      "executable": "git",
      "firstArgs": [
        "status",
        "log",
        "diff",
        "show",
        "rev-parse",
        "ls-files",
        "describe",
        "blame",
        "shortlog",
        "grep"
      ]
    },
    { "executable": "node", "firstArgs": ["--version", "-v"] },
    { "executable": "npm", "firstArgs": ["--version", "-v"] },
    { "executable": "python", "firstArgs": ["--version", "-V"] },
    { "executable": "ls" },
    { "executable": "dir" },
    { "executable": "pwd" },
    { "executable": "where" },
    { "executable": "which" }
  ],
  "redirectionDecision": "ask",
  "compositionDecision": "deny",
  "defaultDecision": "ask"
}
